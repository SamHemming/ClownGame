  m_Script: {fileID: 11500000, guid: afee2d1f15ec8fe4980ef3d0ea80e9cf, type: 3}
  m_Name: Dialogue_TicketMaster_1_Start
  m_EditorClassIdentifier: 
  speakerPrefab: {fileID: 919132149155446097, guid: 25296a152ec6785498f2ca663b7626e2, type: 3}
  speakerName: Ticketmaster
  sentences:
  - text: Little clowns? I can't just let anyone enter the circus
    options: 1
    option1: We have a ticket
    option2: Ticket! Ticket!
  - text: A ticket....
    options: 0
    option1: 
    option2: 
  - text: Even if you have one, my most darling [Wormy cutter] has scittered away.
    options: 0
    option1: 
    option2: 
  - text: I can't let you in without validating your ticket.
    options: 1
    option1: '[Wormy cutter?]'
    option2: '[Cutter?]'
  - text: Yes.. My darling [Wormy cutter]. She has the perfect star shaped mouth
      to validate tickets...
    options: 1
    option1: We'll find!
    option2: Find!!
